{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Building blocks for the LZU Minecraft server.",
  "authors": [
    "Welan",
    "lyningL",
    "NoTuring_Steve"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "minelzu.accesswidener",
  "entrypoints": {
    "main": [
      "io.github.minelzu.minelzu_mod.fabric.MineLZUFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_language_kotlin_version}"
  }
}


